---
import { getCollection } from "astro:content";
import ExperienceCard from "./ExperienceCard.astro";
import { useTranslations } from "../../i18n/ui";

const { lang = "en" } = Astro.props;
const t = useTranslations(lang);

// Filtrar experiencia según el idioma
const experience = await getCollection("experience", ({ id }) => {
  return id.startsWith(`${lang}/`);
});
---

<div class="carousel">
  <div class="carousel-viewport-experience">
    <p class="carousel-title">{t('carousel.experience')}</p>
    <div class="content-object">
      <div class="track carousel-track-horizontal" id="exp-track">
        {experience.map(exp => (
          <div class="carousel-slide">
            <ExperienceCard {...exp.data} />
          </div>
        ))}
      </div>
    </div>
  </div>
  <div class="dots" id="exp-dots">
    {experience.map((_, i) => (
      <span class={`dot ${i === 0 ? 'active' : ''}`} data-index={i}></span>
    ))}
  </div>
</div>

<script>
  const track = document.getElementById('exp-track');
  const dots = document.querySelectorAll('#exp-dots .dot');

  let currentIndex = 0;
  let startX = 0;
  let endX = 0;

  function updateCarousel(index) {
    currentIndex = index;
    if (track) track.style.transform = `translateX(-${currentIndex * 100}%)`;
    
    dots.forEach(d => d.classList.remove('active'));
    if(dots[currentIndex]) dots[currentIndex].classList.add('active');
  }

  dots.forEach((dot, index) => {
    dot.addEventListener('click', () => {
      updateCarousel(index);
    });
  });

  if (track) {
    track.addEventListener('touchstart', (e) => {
      startX = e.touches[0].clientX;
      endX = startX; // Reseteamos endX por si el usuario solo toca sin mover
    }, { passive: true });

    track.addEventListener('touchmove', (e) => {
      endX = e.touches[0].clientX;
    }, { passive: true });

    track.addEventListener('touchend', () => {
      const diffX = startX - endX;
      const threshold = 50; // Cantidad de píxeles necesarios para considerar que fue un "swipe"

      if (diffX > threshold && currentIndex < dots.length - 1) {
        // Deslizó hacia la izquierda -> Siguiente slide
        updateCarousel(currentIndex + 1);
      } else if (diffX < -threshold && currentIndex > 0) {
        // Deslizó hacia la derecha -> Slide anterior
        updateCarousel(currentIndex - 1);
      }
    });
  }

  // dots.forEach(dot => {
  //   dot.addEventListener('click', () => {
  //     const index = parseInt(dot.getAttribute('data-index') || "0");
  //     if (track) track.style.transform = `translateX(-${index * 100}%)`;
      
  //     dots.forEach(d => d.classList.remove('active'));
  //     dot.classList.add('active');
  //   });
  // });
</script>

<style>
.carousel {
  width: 350px;
  position: relative;
}

.track {
  display: flex;
}

.carousel-title {
  color: #fff;
  font-weight: bold;
  opacity: 0.9;
  margin-bottom: 60px;
  padding-bottom: 20px;
  text-align: center;
}
</style>