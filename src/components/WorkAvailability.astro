---
import { useTranslations } from "../i18n/ui";

const { isAvailable, status, lang = "es" } = Astro.props;
const t = useTranslations(lang);

let dataStatus: "1" | "2" | "3";
let label: string;

if (status !== undefined) {
  dataStatus = String(status) as "1" | "2" | "3";
  label = t(`project.status.${dataStatus}` as any);
} else {
  dataStatus = isAvailable ? "1" : "3";
  label = isAvailable ? t("availability.open") : t("availability.closed");
}
---

<div class="work-availability" data-status={dataStatus}>
  <span class="status-text">{label}</span>
</div>

<style>
  .work-availability {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    color: #fff;
    border-radius: 999px;
    padding: 0.55rem 0.25rem;
    font-size: clamp(10px, 2vw, 11px);
    font-family: inherit;
    font-weight: 600;
    letter-spacing: 0.02em;
    position: relative;
  }

  .work-availability::before {
    content: "";
    width: 0.7rem;
    height: 0.7rem;
    border-radius: 50%;
    display: inline-block;
    flex-shrink: 0;
    animation: pulse-dot 3s ease-in-out infinite;
  }

  .work-availability[data-status="1"]::before {
    background: #00ff88;
    box-shadow:
      0 0 15px #00ff88,
      0 0 15px #00ff88;
  }
  .work-availability[data-status="1"] {
    border-color: #22aa47;
  }

  .work-availability[data-status="2"]::before {
    background: #60a5fa;
    box-shadow:
      0 0 15px #60a5fa,
      0 0 15px #60a5fa;
  }
  .work-availability[data-status="2"] {
    border-color: #2563eb;
  }
  
  .work-availability[data-status="3"]::before {
    background: #ffca28;
    box-shadow:
      0 0 15px #ffca28,
      0 0 15px #ffca28;
  }
  .work-availability[data-status="3"] {
    border-color: #d28b00;
  }

  @keyframes pulse-dot {
    0%,
    100% {
      opacity: 1;
      transform: scale(1);
    }
    50% {
      opacity: 0.4;
      transform: scale(0.9);
    }
  }

  .status-text {
    position: relative;
    z-index: 1;
  }
</style>
