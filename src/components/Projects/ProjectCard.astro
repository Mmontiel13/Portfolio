---
import { useTranslations } from "../../i18n/ui";
import { techStack } from "../../content/techStack";

const { lang } = Astro.props;
const t = useTranslations(lang);

const { title, status, description, images, github, tech, page } = Astro.props;
---

<div class="project-card-wrapper">
  <div class="project-card">
    <div class="image-stack" data-images={JSON.stringify(images)}>
      {
        images.map((img, index) => (
          <img
            src={img}
            class={`stack-img ${index === 0 ? "active" : ""}`}
            style={`--index: ${index};`}
            alt={`${title} screenshot ${index}`}
            loading="lazy"
          />
        ))
      }
      <div class="stack-hint">
        <i class="fa-solid fa-hand-pointer"></i>
      </div>
    </div>

    <div class="project-info">
      <h1>{title}</h1>
      
      <p>{description}</p>

      <div class="tech-container">
        {
          tech &&
            tech.map((item) => {
              const stack = techStack[item];

              return (
                <span class="tech-tag">
                  {stack?.icon && <i class={stack.icon} />}
                  {item}
                </span>
              );
            })
        }
      </div>

      <div class="actions">
        {
          github ? (
            <a
              class="btn github-link"
              href={github}
              target="_blank"
              rel="noopener noreferrer"
            >
              <i class="fa-brands fa-github fa-lg" /> Github
            </a>
          ) : (
            <span class="btn btn-disabled">
              <i class="fa-solid fa-lock fa-sm" /> Github
            </span>
          )
        }

        {
          page ? (
            <a
              class="btn"
              href={page}
              target="_blank"
              rel="noopener noreferrer"
            >
              <i class="fa-solid fa-location-arrow fa-lg" />
              {t("project.page")}
            </a>
          ) : (
            <span class="btn btn-disabled">
              <i class="fa-solid fa-lock fa-sm" /> Web
            </span>
          )
        }
      </div>
    </div>
  </div>
</div>

<style>
  .project-card-wrapper {
    padding: clamp(20px, 5vw, 30px);
    padding-bottom: 0;
    width: 100%;
    box-sizing: border-box;
    scroll-snap-align: center;
    scroll-snap-stop: always;
    flex-shrink: 0;
  }

  .project-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: clamp(12px, 3vw, 20px);
    width: 100%;
    max-width: 100%;
    box-sizing: border-box;
    padding: 0;
    overflow: visible;
  }

  @media (min-width: 600px) {
    .project-card {
      flex-direction: column;
      align-items: center;
      gap: clamp(30px, 8vw, 20px);
      max-width: 100%;
    }
  }

  @media (min-width: 1200px) {
    .project-card {
      flex-direction: row;
      align-items: flex-start;
      gap: clamp(30px, 8vw, 100px);
      max-width: 100%;
    }
  }

  .project-info {
    flex: 1;
    max-width: 100%;
    text-align: left;
    padding-bottom: 0;
    padding-top: 20px;
  }

  h1 {
    font-size: clamp(18px, 5vw, 26px);
    margin-bottom: clamp(12px, 3vw, 20px);
    font-weight: 700;
    text-align: left;
    line-height: 1.2;
  }

  p {
    opacity: 0.8;
    margin-top: clamp(12px, 3vw, 20px);
    margin-bottom: clamp(16px, 3vw, 25px);
    font-size: clamp(13px, 3vw, 15px);
    line-height: 1.6;
  }

  .tech-container {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(8px, 2vw, 12px);
    margin-bottom: clamp(20px, 4vw, 30px);
  }

  .tech-tag {
    font-size: clamp(11px, 2vw, 12px);
    padding: clamp(3px, 1vw, 4px) clamp(8px, 2vw, 12px);
    border-radius: 999px;
    background: rgba(217, 217, 217, 0.1);
    color: rgba(217, 217, 217, 0.8);
    border: 1px solid rgba(217, 217, 217, 0.2);
    font-weight: 500;
  }

  .private-badge {
    font-size: clamp(11px, 2vw, 13px);
    color: rgba(217, 217, 217, 0.4);
    font-style: italic;
    display: flex;
    align-items: center;
    gap: 8px;
    padding-left: 10px;
  }

  .btn-disabled {
    opacity: 0.45;
    cursor: not-allowed;
    pointer-events: none;

    border: 1px solid rgba(255, 255, 255, 0.08);
    color: rgba(255, 255, 255, 0.5);

    background: rgba(255, 255, 255, 0.02);
  }

  .btn-disabled:hover {
    border: 1px solid rgba(255, 255, 255, 0.08);
    color: rgba(255, 255, 255, 0.5);
    transform: none;
  }

  .actions {
    margin-top: clamp(8px, 2vw, 10px);
    margin-bottom: clamp(12px, 3vw, 20px);
  }

  .private-badge i {
    font-size: clamp(10px, 2vw, 12px);
  }

  .tech-tag {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .tech-tag i {
    font-size: 15px;
  }

  /*Imagenes*/
  .image-stack {
    position: relative;
    width: 100%;
    max-width: 420px;
    aspect-ratio: 16 / 10;
    cursor: pointer;
    perspective: 1200px;
    margin: 20px;
  }

  @media (min-width: 640px) {
    .image-stack {
      max-width: 620px;
    }
  }

  .stack-img {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: auto;
    border-radius: 18px;
    transition: all 0.6s cubic-bezier(0.23, 1, 0.32, 1);
    box-shadow: 0 15px 35px rgba(0, 0, 0, 0.6);
    transform: translateX(calc(var(--index) * -5px))
      translateY(calc(var(--index) * -20px))
      translateZ(calc(var(--index) * -40px)) rotateX(calc(var(--index) * 2deg));

    opacity: calc(1 - (var(--index) * 0.25));
    z-index: calc(10 - var(--index));
    filter: blur(calc(var(--index) * 1px));
  }
  .stack-img.active {
    transform: translateZ(50px) scale(1);
    opacity: 1;
    z-index: 20;
    transform: translateZ(0) scale(1);
    filter: none;
  }

  .stack-img.exit {
    transform: translateX(-60%) rotate(-10deg);
    opacity: 0.2;
  }
  .image-stack:hover .stack-img.active {
    transform: translateZ(20px) scale(1.02);
  }

  .stack-hint {
    position: absolute;
    bottom: 20px;
    right: 20px;
    background: rgba(0, 0, 0, 0.7);
    backdrop-filter: blur(4px);
    color: white;
    padding: 8px 15px;
    border-radius: 999px;
    font-size: 12px;
    display: flex;
    align-items: center;
    gap: 8px;
    z-index: 30;
    opacity: 0;
    pointer-events: none;
    transition:
      opacity 0.5s ease,
      transform 0.5s ease;

    pointer-events: none;
    border: 1px solid rgba(255, 255, 255, 0.2);
  }

  .image-stack.is-visible:not(.clicked) .stack-hint {
    opacity: 1;
    transform: translateY(0);
  }
  .image-stack.clicked .stack-hint {
    opacity: 0 !important;
    visibility: hidden;
  }
</style>
<script>
  function setupStacks() {
    const stacks = document.querySelectorAll(".image-stack");
    const userKnowsShuffle = () =>
      sessionStorage.getItem("user_knows_shuffle") === "true";

    stacks.forEach((stack) => {
      const images = stack.querySelectorAll(".stack-img");
      let currentIndex = 0;
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting && !userKnowsShuffle()) {
              stack.classList.add("is-visible");

              setTimeout(() => {
                stack.classList.remove("is-visible");
              }, 3000);

              observer.unobserve(stack);
            }
          });
        },
        { threshold: 0.6 },
      );

      observer.observe(stack);

      const rotateImages = () => {
        sessionStorage.setItem("user_knows_shuffle", "true");
        document
          .querySelectorAll(".image-stack")
          .forEach((s) => s.classList.add("clicked"));

        const currentImg = images[currentIndex];
        currentImg.classList.add("exit");
        currentImg.classList.remove("active");

        setTimeout(() => {
          currentImg.classList.remove("exit");
          currentIndex = (currentIndex + 1) % images.length;

          images.forEach((img, i) => {
            const newIndex = (i - currentIndex + images.length) % images.length;
            (img as HTMLElement).style.setProperty(
              "--index",
              newIndex.toString(),
            );

            if (newIndex === 0) {
              img.classList.add("active");
            } else {
              img.classList.remove("active");
            }
          });
        }, 400);
      };

      stack.addEventListener("click", rotateImages);
    });
  }

  setupStacks();
  document.addEventListener("astro:after-swap", setupStacks);
</script>
